<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Virtual Touring Solutions for Gyms and Restaurants in Oakland County">
  <title>Oakland Virtual Tours</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body { margin: 0; font-family: 'Roboto', sans-serif; line-height: 1.6; color: #333; }
    header { background: #0a192f; color: #fff; padding: 1.5rem; text-align: center; }
    nav a { color: #fff; margin: 0 1rem; text-decoration: none; font-weight: bold; }
    .hero { background: url('your-hero-image.jpg') center/cover no-repeat; color: #fff; padding: 6rem 1rem; text-align: center; }
    .hero h1 { font-size: 2.5rem; }
    .section { padding: 4rem 1rem; max-width: 1200px; margin: auto; }
    .services, .lookbook-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
    .service-item, .lookbook-item { background: #f4f4f4; padding: 1.5rem; border-radius: 8px; }
    form { display: flex; flex-direction: column; gap: 1rem; max-width: 600px; margin: auto; }
    input, textarea { padding: 0.75rem; border: 1px solid #ccc; border-radius: 5px; }
    button { padding: 0.75rem; background: #0a192f; color: #fff; border: none; border-radius: 5px; cursor: pointer; font-size: 1rem; }
    button:hover { background: #112d4e; }
    footer { background: #0a192f; color: #fff; text-align: center; padding: 1rem; margin-top: 4rem; }
  </style>
</head>
<body>

<header>
  <h1>Oakland Virtual Tours</h1>
  <nav>
    <a href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#lookbook">Look Book</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<section id="home" class="hero">
  <h1>Bring Your Business to Life with 360° Virtual Tours</h1>
  <p>Specializing in gyms, restaurants, and small businesses across Oakland County.</p>
  <a href="#contact"><button>Get a Free Quote</button></a>
</section>

<section id="services" class="section">
  <h2>Our Services</h2>
  <div class="services">
    <div class="service-item">
      <h3>360° Virtual Tours</h3>
      <p>Let customers walk through your business online from anywhere, anytime.</p>
    </div>
    <div class="service-item">
      <h3>Professional Photography</h3>
      <p>High-quality images that showcase your brand in the best light.</p>
    </div>
    <div class="service-item">
      <h3>Drone Photography</h3>
      <p>Aerial shots that give your location a breathtaking perspective.</p>
    </div>
    <div class="service-item">
      <h3>LiDAR Scanning (Coming Soon)</h3>
      <p>Advanced 3D mapping technology for even more detailed virtual experiences.</p>
    </div>
    <div class="service-item">
      <h3>3D Render Services (Coming Soon)</h3>
      <p>Fully immersive digital recreations for marketing and planning.</p>
    </div>
  </div>
</section>

<section id="lookbook" class="section">
  <h2>Look Book</h2>
  <div class="lookbook-gallery">
    <div class="lookbook-item"><img src="sample1.jpg" alt="Project 1" style="width:100%; border-radius:8px;"></div>
    <div class="lookbook-item"><img src="sample2.jpg" alt="Project 2" style="width:100%; border-radius:8px;"></div>
    <div class="lookbook-item"><img src="sample3.jpg" alt="Project 3" style="width:100%; border-radius:8px;"></div>
    <!-- Add more images as needed -->
  </div>
</section>

<section id="contact" class="section">
  <h2>Contact Us</h2>
  <form action="https://formspree.io/f/{your-form-id}" method="POST">
    <input type="text" name="name" placeholder="Your Name" required>
    <input type="email" name="email" placeholder="Your Email" required>
    <textarea name="message" rows="5" placeholder="Tell us about your project..." required></textarea>
    <button type="submit">Send Message</button>
  </form>
</section>

<footer>
  <p>&copy; 2025 Oakland Virtual Tours. All Rights Reserved.</p>
</footer>

</body>
</html>
